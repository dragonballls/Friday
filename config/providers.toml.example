[default]
provider = "openrouter"

[routing]
# Optional explicit primary. Leave blank to use the default provider and
# automatically fall back across configured cloud providers.
primary = ""
fallback = ["openai", "gemini", "deepseek", "zen_coder"]

[openai]
api_key = ""
base_url = "https://api.openai.com/v1"
model = "gpt-5.6-luna"
temperature = 0.7
max_tokens = 4096
provider_name = "openai"

[openrouter]
api_key = ""
base_url = "https://openrouter.ai/api/v1"
model = "openrouter/free"
timeout = 45
temperature = 0.7
max_tokens = 4096
provider_name = "openrouter"

# Google Gemini through Google's OpenAI-compatible endpoint.
[gemini]
api_key = ""
base_url = "https://generativelanguage.googleapis.com/v1beta/openai/"
model = "gemini-3.8-flash"
timeout = 45
temperature = 0.7
max_tokens = 4096
provider_name = "gemini"

[deepseek]
api_key = ""
base_url = "https://api.deepseek.com"
model = "deepseek-v4-flash"
temperature = 0.7
max_tokens = 4096
provider_name = "deepseek"

# Optional coding-focused cloud provider.
[zen_coder]
api_key = ""
base_url = "https://opencode.ai/zen/v1"
model = "mimo-v2.5-free"
fallback_provider = "openrouter"
timeout = 60
temperature = 0.2
max_tokens = 8192
provider_name = "zen_coder"

# No local embedding/model runtime. TF-IDF is a lightweight non-ML text index.
[embeddings]
engine = "tfidf"
